# Resend API-nyckel för mailutskick via kontaktformuläret
# 1. Skapa ett konto på resend.com
# 2. Hämta din API-nyckel under API Keys i dashboarden
# 3. Kopiera den här till .env.local och klistra in nyckeln
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxx

# Annonsspårning – laddas först när besökaren godkänt cookies.
# Lämna tomt för att stänga av en pixel. Lägg in samma variabler i Vercel → Settings → Environment Variables.
VITE_META_PIXEL_ID=
VITE_GOOGLE_TAG_ID=
# Valfritt: Google Ads-konvertering i formatet AW-123456789/AbC-dEfGhIj
VITE_GOOGLE_ADS_CONVERSION=
VITE_TIKTOK_PIXEL_ID=
